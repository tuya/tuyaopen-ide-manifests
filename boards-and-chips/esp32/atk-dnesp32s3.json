        "id": "lcd-st7789",
        "name": {
          "en": "ST7789 LCD",
          "zh-CN": "ST7789 显示屏"
        },
        "interface": "SPI",
        "mounting": "accessory",
        "pinLocked": false,
        "port": 0,
        "model": "ST7789",
        "width": 320,
        "height": 240,
        "pixelFormat": "RGB565",
        "backlight": "CUSTOM",
        "blPwmChannel": 0,
        "timing": {
          "syncMode": "VH",
          "clkEdge": "rising"
        },
        "pins": {
          "SPI": [
            {
              "role": "sck",
              "gpio": 12
            },
            {
              "role": "mosi",
              "gpio": 11
            },
            {
              "role": "cs",
              "gpio": 21
            },
            {
              "role": "dc",
              "gpio": 40
            }
          ]
        },
        "kconfig": null,
        "note": {
          "en": "Reset is unused (rst=-1); backlight is driven via the XL9555 IO expander, not a direct GPIO.",
          "zh-CN": "复位脚未使用（rst=-1）；背光由 XL9555 IO 扩展芯片控制，非直连 GPIO。"
        }
      },
      {
        "id": "rgb-lcd-connector",
        "name": {
          "en": "RGB LCD Connector (J1)",
          "zh-CN": "RGB LCD 接插件 (J1)"
        },
        "interface": "RGB",
        "mounting": "connector",
        "pinLocked": true,
        "pixelFormat": "RGB565",
