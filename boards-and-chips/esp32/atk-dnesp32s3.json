              "role": "pwdn",
              "expanderId": "io-expander-xl9555",
              "expanderPin": 4
            },
            {
              "role": "rst",
              "expanderId": "io-expander-xl9555",
              "expanderPin": 5
            }
          ]
        },
        "kconfig": null,
        "note": {
          "en": "OV2640-class DVP camera header (P2) — no camera fitted; attach any compatible DVP module. No XCLK/MCLK is broken out on the header. SCCB (i2c_scl=IO38 / i2c_sda=IO39) is shared with the capacitive-touch I2C; data pins are shared with the RGB LCD header. PWDN/RESET via XL9555 (#4/#5).",
          "zh-CN": "OV2640 类 DVP 摄像头排针 (P2) —— 未接摄像头，可接任意兼容 DVP 模块。排针未引出 XCLK/MCLK。SCCB（i2c_scl=IO38 / i2c_sda=IO39）与电容触摸 I2C 共用；数据脚与 RGB LCD 排针共用。PWDN/复位经 XL9555（#4/#5）。"
        }
      }
    ],
    "touchpad": [
      {
        "id": "ctp-connector",
        "name": {
          "en": "Capacitive Touch (on RGB LCD connector)",
          "zh-CN": "电容触摸（RGB 屏接插件上）"
        },
        "interface": "I2C",
        "mounting": "connector",
        "pinLocked": true,
        "pins": {
          "I2C": [
            {
              "role": "scl",
              "gpio": 38
            },
            {
              "role": "sda",
              "gpio": 39
            },
            {
              "role": "int",
              "gpio": 40
            },
            {
              "role": "rst",
              "expanderId": "io-expander-xl9555",
              "expanderPin": 9
            }
          ]
        },
        "kconfig": null,
        "note": {
          "en": "Capacitive touch controller on the RGB LCD connector (J1). I2C shared with the DVP camera SCCB (scl=IO38 / sda=IO39); INT=IO40 (shared with LCD_DC); reset via XL9555 #9. Present only when a touch-capable RGB panel is attached.",
          "zh-CN": "RGB LCD 接插件 (J1) 上的电容触摸控制器。I2C 与 DVP 摄像头 SCCB 共用（scl=IO38 / sda=IO39）；INT=IO40（与 LCD_DC 共用）；复位经 XL9555 #9。仅在接入带触摸的 RGB 屏时存在。"
        },
        "group": "rgb-lcd-panel"
      }
    ]
  },
