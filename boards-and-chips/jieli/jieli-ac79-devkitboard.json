{
  "schemaVersion": 1,
  "peripheralPatterns": {
    "sd-card": [
      {
        "id": "tf-slot",
        "name": {
          "en": "TF card slot",
          "zh-CN": "TF 卡槽"
        },
        "interface": "SDIO",
        "mounting": "onboard",
        "pinLocked": true,
        "pins": {
          "SDIO": [
            {
              "role": "clk",
              "gpio": 23
            },
            {
              "role": "cmd",
              "gpio": 22
            },
            {
              "role": "d0",
              "gpio": 21
            }
          ]
        },
        "kconfig": null,
        "note": {
          "en": "The board SDK selects SD0 group A in 1-bit mode: PB7=CLK, PB6=CMD, PB5=DATA0.",
          "zh-CN": "板级 SDK 选择 SD0 A 组单线模式：PB7=CLK、PB6=CMD、PB5=DATA0。"
        }
      }
    ],
    "audio": [
      {
        "id": "speaker-amp",
        "name": {
          "en": "Speaker output",
          "zh-CN": "扬声器输出"
        },
        "interface": "INTERNAL",
        "mounting": "onboard",
        "pinLocked": true,
        "pins": {
          "INTERNAL": [
            {
              "role": "mute",
              "gpio": 18,
              "activeLevel": "low"
            }
          ]
        },
        "kconfig": null,
        "note": {
          "en": "PB2 controls the DAC mute/amplifier mute line; SDK TCFG_DAC_MUTE_VALUE=0. Analog microphone inputs are not digital GPIOs.",
          "zh-CN": "PB2 控制 DAC 静音/功放静音线；SDK 设置 TCFG_DAC_MUTE_VALUE=0。模拟麦克风输入不是数字 GPIO。"
        }
      }
    ],
    "button": [
      {
        "id": "adkey",
        "name": {
          "en": "ADKEY input",
          "zh-CN": "ADKEY 按键输入"
        },
        "interface": "ADC",
        "mounting": "onboard",
        "pinLocked": true,
        "pins": {
          "ADC": [
            {
              "role": "key",
              "gpio": 17
            }
          ]
        },
        "kconfig": null,
        "note": {
          "en": "PB1 is the board SDK ADKEY input.",
          "zh-CN": "PB1 是板级 SDK 配置的 ADKEY 输入。"
        }
      }
    ],
    "camera": [
      {
        "id": "dvp-camera-connector",
        "name": {
          "en": "DVP camera connector",
          "zh-CN": "DVP 摄像头接口"
        },
        "interface": "DVP",
        "mounting": "accessory",
        "pinLocked": true,
        "pins": {
          "DVP": [
            {
              "role": "d0",
              "gpio": 0
            },
            {
              "role": "d1",
              "gpio": 1
            },
            {
              "role": "d2",
              "gpio": 2
            },
            {
              "role": "d3",
              "gpio": 3
            },
            {
              "role": "d4",
              "gpio": 4
            },
            {
              "role": "d5",
              "gpio": 5
            },
            {
              "role": "d6",
              "gpio": 6
            },
            {
              "role": "d7",
              "gpio": 7
            },
            {
              "role": "pclk",
              "gpio": 8
            },
            {
              "role": "hsync",
              "gpio": 9
            },
            {
              "role": "vsync",
              "gpio": 10
            },
            {
              "role": "mclk",
              "gpio": 114
            },
            {
              "role": "rst",
              "gpio": 115
            },
            {
              "role": "i2c_scl",
              "gpio": 112
            },
            {
              "role": "i2c_sda",
              "gpio": 113
            }
          ]
        },
        "kconfig": null,
        "note": {
          "en": "Optional camera module. The WL82 DevKit SDK selects DVP group A: PA0–PA10 for data/sync, PH0/PH1 for SCCB, PH2=MCLK, PH3=RESET.",
          "zh-CN": "可选摄像头模组。WL82 DevKit SDK 选择 DVP A 组：PA0–PA10 用于数据/同步，PH0/PH1 为 SCCB，PH2=MCLK，PH3=RESET。"
        }
      }
    ],
    "display": [
      {
        "id": "lcd-mcu8080",
        "name": {
          "en": "LCD daughterboard (MCU/RGB connector)",
          "zh-CN": "LCD 显示子板（MCU/RGB 接口）"
        },
        "interface": "MCU8080",
        "mounting": "accessory",
        "pinLocked": true,
        "pins": {
          "MCU8080": [
            {
              "role": "wr",
              "gpio": 42
            },
            {
              "role": "dc",
              "gpio": 41
            },
            {
              "role": "d7",
              "gpio": 40
            },
            {
              "role": "d6",
              "gpio": 39
            },
            {
              "role": "d5",
              "gpio": 38
            },
            {
              "role": "d4",
              "gpio": 37
            },
            {
              "role": "d3",
              "gpio": 36
            },
            {
              "role": "d2",
              "gpio": 35
            },
            {
              "role": "d1",
              "gpio": 34
            },
            {
              "role": "d0",
              "gpio": 33
            },
            {
              "role": "bl",
              "gpio": 24
            },
            {
              "role": "te",
              "gpio": 32
            }
          ]
        },
        "kconfig": null,
        "note": {
          "en": "JL_AC79_DevKitLCD V1.2 is a separate daughterboard. J17 maps PC10=WR/HSYNC, PC9=RS/VSYNC, PC8=EMI_D7/LCD_DCLK, PC7–PC1=EMI_D6–D0/LCD_D0–D6, PC0=TE/LCD_D7, and PB8=BL/DE; interface mode determines the muxed signal name.",
          "zh-CN": "JL_AC79_DevKitLCD V1.2 是独立显示子板。J17 映射为 PC10=WR/HSYNC、PC9=RS/VSYNC、PC8=EMI_D7/LCD_DCLK、PC7–PC1=EMI_D6–D0/LCD_D0–D6、PC0=TE/LCD_D7、PB8=BL/DE；复用信号名取决于接口模式。"
        }
      }
    ],
    "touchpad": [
      {
        "id": "lcd-touch-panel",
        "name": {
          "en": "LCD daughterboard touch interface",
          "zh-CN": "LCD 显示子板触摸接口"
        },
        "interface": "I2C",
        "mounting": "accessory",
        "pinLocked": true,
        "pins": {
          "I2C": [
            {
              "role": "scl",
              "gpio": 112
            },
            {
              "role": "sda",
              "gpio": 113
            },
            {
              "role": "int",
              "gpio": 16
            },
            {
              "role": "rst",
              "gpio": 20
            }
          ]
        },
        "kconfig": null,
        "note": {
          "en": "Schematic J17 assigns PH0=SCL, PH1=SDA, PB0=INT and PB4=RESET. These INT/RESET labels differ from the field names in the legacy DevKitBoard.c configuration; the schematic net names are used here.",
          "zh-CN": "原理图 J17 分配 PH0=SCL、PH1=SDA、PB0=INT、PB4=RESET。该 INT/RESET 标注与旧版 DevKitBoard.c 配置中的字段名不一致，此处按原理图网络标注。"
        }
      }
    ]
  },
  "links": {
