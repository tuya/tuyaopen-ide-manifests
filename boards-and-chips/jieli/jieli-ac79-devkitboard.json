  "expansionConnectors": [
    {
      "id": "j18-gpio-header",
      "name": {
        "en": "J18 expansion GPIO header",
        "zh-CN": "J18 扩展 GPIO 排针"
      },
      "note": {
        "en": "19x2 header. PA0–PA10 are shared with the default DVP camera; PB5–PB7 are shared with the TF slot; PB3 is also the SDK debug UART1 TX. Disconnect/reconfigure those functions before using the pins as general GPIO.",
        "zh-CN": "19×2 排针。PA0–PA10 与默认 DVP 摄像头复用；PB5–PB7 与 TF 卡槽复用；PB3 也是 SDK 调试 UART1 TX。将引脚作为普通 GPIO 使用前须断开或重新配置相关功能。"
      },
      "provides": [
        {
          "deviceClass": "gpio",
          "interface": "GPIO"
        }
      ]
    }
  ],
