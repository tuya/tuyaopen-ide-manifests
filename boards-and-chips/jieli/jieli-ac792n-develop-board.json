    "display": [
      {
        "id": "display-expansion",
        "name": {
          "en": "RGB/MIPI display expansion",
          "zh-CN": "RGB/MIPI 显示扩展"
        },
        "interface": "RGB",
        "mounting": "accessory",
        "pinLocked": true,
        "kconfig": null,
        "note": {
          "en": "J26 fixed RGB mux: PA4–PA11=LCD_D0–D7, PB0–PB15=LCD_D8–D23, PA12=LCD_DEN, PA13=LCD_DCLK, PA14=LCD_HSYNC and PA15=LCD_VSYNC. Other functions are muxed on these same GPIOs; reset/backlight/power assignments depend on the display top board.",
          "zh-CN": "J26 固定 RGB 复用信号：PA4–PA11=LCD_D0–D7、PB0–PB15=LCD_D8–D23、PA12=LCD_DEN、PA13=LCD_DCLK、PA14=LCD_HSYNC、PA15=LCD_VSYNC。相同 GPIO 还复用其他功能；复位/背光/电源分配由显示顶板决定。"
        },
