    "sd-card": [
      {
        "id": "tf2",
        "name": {
          "en": "TF2 card slot",
          "zh-CN": "TF2 卡槽"
        },
        "interface": "SDIO",
        "mounting": "onboard",
        "pinLocked": true,
        "pins": {
          "SDIO": [
            {
              "role": "cd",
              "gpio": 49
            },
            {
              "role": "d3",
              "gpio": 50
            },
            {
              "role": "d2",
              "gpio": 51
            },
            {
              "role": "d1",
              "gpio": 52
            },
            {
              "role": "d0",
              "gpio": 53
            },
            {
              "role": "cmd",
              "gpio": 54
            },
            {
              "role": "clk",
              "gpio": 55
            }
          ]
        },
        "kconfig": null,
        "note": {
          "en": "Schematic J35: PD1=SD_DET, PD2–PD5=SD_DAT3–0, PD6=SD_CMD, PD7=SD_CLK. AC7926A SDK SD0_A profile cross-checks the bus mapping. PD1 is also the default UART0 debug TX in that SDK profile, so card detect and logging TX conflict unless reconfigured.",
          "zh-CN": "原理图 J35：PD1=SD_DET、PD2–PD5=SD_DAT3–0、PD6=SD_CMD、PD7=SD_CLK。AC7926A SDK 的 SD0_A 配置与总线映射一致。该 SDK 配置还默认用 PD1 作为 UART0 调试 TX，因此卡检测和日志 TX 会冲突，除非重新配置。"
        }
      }
    ],
    "audio": [
      {
        "id": "analog-audio",
        "name": {
          "en": "Analog microphone and speaker path",
          "zh-CN": "模拟麦克风与扬声器通路"
        },
        "interface": "INTERNAL",
        "mounting": "onboard",
        "pinLocked": true,
        "pins": {
          "INTERNAL": [
            {
              "role": "mute",
              "gpio": 79,
              "activeLevel": "high"
            }
          ]
        },
        "kconfig": null,
        "note": {
          "en": "Speaker mute/PA control is PE15 (GPIO79), active high (AC7926A SDK profile cross-check). The V1.2 schematic labels MIC1+/- on PC7/PC6 (GPIO39/38) and MIC2+/- on PC11/PC12 (GPIO43/44). AUX LINE IN is an analog J4 connection, not a digital GPIO.",
          "zh-CN": "扬声器静音/功放控制为 PE15（GPIO79），高有效（以 AC7926A SDK 配置交叉核对）。V1.2 原理图标注 MIC1+/− 接 PC7/PC6（GPIO39/38），MIC2+/− 接 PC11/PC12（GPIO43/44）。AUX LINE IN 是 J4 模拟音频接口，不是数字 GPIO。"
        }
      }
    ],
    "button": [
      {
        "id": "adkey",
        "name": {
          "en": "ADKEY input",
          "zh-CN": "ADKEY 按键输入"
        },
        "interface": "ADC",
        "mounting": "onboard",
        "pinLocked": true,
        "pins": {
